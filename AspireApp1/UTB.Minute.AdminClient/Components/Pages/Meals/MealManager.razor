            try
            {
                MealStateRequestDto state = new() { IsActive = !meal.IsActive };
                await CanteenService.ChangeMealStateAsync(state, meal.Id);
                meal.IsActive = !meal.IsActive;
            }
            catch (Exception e) { errorMessage = e.Message; }
        }
