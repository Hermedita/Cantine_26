@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using UTB.Minute.Contracts
@inject CanteenService CanteenService

<PageTitle>Meal Manager</PageTitle>

@if(!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<h3>Meals</h3>

<AuthorizeView Roles="admin-admin">
    <Authorized>
        <p>Welcome back @context.User.Identity?.Name !</p>

        <form action="logout" method="post">
            <AntiforgeryToken />
            <button type="submit" class="nav-link btn btn-link">Logout</button>
        </form>

    </Authorized>
    <NotAuthorized>
        <p><a href="/login?returnUrl=/">Log in</a> please.</p>
    </NotAuthorized>
</AuthorizeView>

@if(meals is null)
{
    <p>Loading ... </p>    
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Name</th>
                <th scope="col">Description</th>
                <th scope="col">Price</th>
                <th scope="col">Is Active</th>
            </tr>
        </thead>
        <tbody>

            @foreach(MealDto meal in meals)
            {
                <tr>
                    <th scope="row">@meal.Id</th>
                    <td>@meal.Name</td>
                    <td>@meal.Description</td>
                    <td>@meal.Price</td>
                    <td>@meal.IsActive</td>
                        <td>
                            <AuthorizeView Roles="admin-admin">
                                <Authorized>
                                    <button type="button"
                                            class="btn @(meal.IsActive ? "btn-warning" : "btn-success")"
                                            @onclick="() => ToggleMealActiveAsync(meal)">
                                        @(meal.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </Authorized>
                                <NotAuthorized>
                                    <!-- no toggle for unauthorized users -->
                                </NotAuthorized>
                            </AuthorizeView>
                        </td>
                    <td>
                        <AuthorizeView Roles="admin-admin">
                            <Authorized>
                        <a href="/meals/update/@meal.Id" class="btn btn-primary">Edit Meal</a>
                            </Authorized>
                            <NotAuthorized>
                                <!-- no edit for unauthorized -->
                            </NotAuthorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }

        </tbody>

    </table>
}
<br />
<AuthorizeView Roles="admin-admin">
    <Authorized>
<a class="btn btn-primary" href="/meals/create">Create New Meal</a>
    </Authorized>
    <NotAuthorized>
        <!-- no create for unauthorized -->
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? errorMessage;
    private MealDto[]? meals;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load meals for everyone so anonymous users can view the list
            meals = await CanteenService.GetMealsAsync();
        }
        catch (HttpRequestException ex)
        {
            // Show detailed message to help diagnose connectivity/auth issues
            errorMessage = $"There has been an error loading meals: {ex.Message}";
            meals = Array.Empty<MealDto>();
        }
    }

    protected async Task ToggleMealActiveAsync(MealDto meal)
    {
        try
        {
            if (meal.IsActive)
            {
                MealStateRequestDto state = new(){
                  IsActive = false
                };
                await CanteenService.ChangeMealStateAsync(state,meal.Id);
            }
            else
            {
                MealStateRequestDto state = new(){
                  IsActive = true  
                };
                await CanteenService.ChangeMealStateAsync(state,meal.Id);
            }
            meal.IsActive = !meal.IsActive;
        }
        catch (HttpRequestException e){
            errorMessage = e.ToString();
        }
    }
}