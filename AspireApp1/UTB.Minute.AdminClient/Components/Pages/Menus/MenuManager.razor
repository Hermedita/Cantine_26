@page "/menus"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using UTB.Minute.Contracts
@inject CanteenService CanteenService

<PageTitle>Menu Manager</PageTitle>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<h3>Menu</h3>

<AuthorizeView Roles="admin-admin">
    <Authorized>
        <p>Welcome back @context.User.Identity?.Name !</p>

        <form action="logout" method="post">
            <AntiforgeryToken />
            <button type="submit" class="nav-link btn btn-link">Logout</button>
        </form>

    </Authorized>
    <NotAuthorized>
        <p><a href="/login?returnUrl=/menus">Log in</a> please.</p>
    </NotAuthorized>
</AuthorizeView>

@if (menus is null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Name</th>
                <th scope="col">Date</th>
                <th scope="col">Portions</th>
                <th scope="col"></th>
                <th scope="col"></th>
            </tr>
        </thead>

        <tbody>
            @for (int i = 0; i < menus.Length; i++)
            {
                var menu = menus[i];

                <tr>
                    <th scope="row">@(i + 1)</th>
                    <td>@menu.MealName</td>
                    <td>@menu.Date</td>
                    <td>@menu.Portions</td>
                    <td>
                        <AuthorizeView Roles="admin-admin">
                            <Authorized>
                                <a href="/menus/update/@menu.Id" class="btn btn-primary">Edit</a>
                            </Authorized>
                            <NotAuthorized>
                                <!-- no edit for unauthorized -->
                            </NotAuthorized>
                        </AuthorizeView>
                    </td>
                    <td>
                        <AuthorizeView Roles="admin-admin">
                            <Authorized>
                                <button class="btn btn-danger" @onclick="() => DeleteMenu(menu.Id)">
                                    Delete
                                </button>
                            </Authorized>
                            <NotAuthorized>
                                <!-- no delete for unauthorized -->
                            </NotAuthorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<br />

<AuthorizeView Roles="admin-admin">
    <Authorized>
        <a class="btn btn-primary" href="/menus/create">Create New</a>
    </Authorized>
    <NotAuthorized>
        <!-- No create button for anonymous users -->
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? errorMessage;
    private MenuDto[]? menus;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            menus = await CanteenService.GetMenusAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "There has been an error";
        }
    }

    private async Task DeleteMenu(int id)
    {
        try
        {
            await CanteenService.DeleteMenuAsync(id);
            menus = await CanteenService.GetMenusAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Menu could not be deleted.";
        }
    }
}