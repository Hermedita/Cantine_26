@page "/menus/create"
@rendermode InteractiveServer
@using UTB.Minute.Contracts
@inject NavigationManager Navigation
@inject CanteenService CanteenService

<PageTitle>Create Menu</PageTitle>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning">@errorMessage</div>
}

<h3>Create Menu</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!meals.Any(m => m.IsActive))
{
    <div class="alert alert-warning">
        No active meals are available. Create or activate a meal before creating a menu.
    </div>
    <a class="btn btn-secondary" href="/menus">Back to menus</a>
}
else
{
    <EditForm Model="menu" OnValidSubmit="CreateMenuSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Meal</label>
            <InputSelect class="form-control" @bind-Value="menu.MealId">
                <option value="0">-- Choose meal --</option>

                @foreach (var meal in meals.Where(m => m.IsActive))
                {
                    <option value="@meal.Id">@meal.Name</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label>Date</label>
            <InputDate class="form-control" @bind-Value="menu.Date" />
        </div>

        <div class="mb-3">
            <label>Portions</label>
            <InputNumber class="form-control" @bind-Value="menu.Portions" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
            @(isSubmitting ? "Saving..." : "Create Menu")
        </button>
        <a class="btn btn-secondary" href="/menus">Cancel</a>
    </EditForm>
}

@code {
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSubmitting;

    private MenuRequestDto menu = new()
    {
        MealId = 0,
        Date = DateOnly.FromDateTime(DateTime.Today),
        Portions = 0,
    };

    private List<MealDto> meals = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await CanteenService.GetMealsAsync();
            meals = result?.ToList() ?? new List<MealDto>();
        }
        catch (HttpRequestException e)
        {
            errorMessage = e.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateMenuSubmit()
    {
        errorMessage = null;

        if (!ValidateMenuForm())
        {
            return;
        }

        try
        {
            isSubmitting = true;
            await CanteenService.CreateMenuAsync(menu);
            Navigation.NavigateTo("/menus");
        }
        catch (HttpRequestException e)
        {
            errorMessage = e.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool ValidateMenuForm()
    {
        if (menu.MealId == 0)
        {
            errorMessage = "Please choose a meal.";
            return false;
        }

        if (!meals.Any(m => m.Id == menu.MealId && m.IsActive))
        {
            errorMessage = "Please choose an active meal.";
            return false;
        }

        if (menu.Date < DateOnly.FromDateTime(DateTime.Today))
        {
            errorMessage = "Date must not be older than today.";
            return false;
        }

        if (menu.Portions <= 0)
        {
            errorMessage = "Portions must be greater than 0.";
            return false;
        }

        return true;
    }
}