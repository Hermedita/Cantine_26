@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using UTB.Minute.Contracts
@inject CanteenService CanteenService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Today's Menu</PageTitle>

<h3>Today's Menu</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning">@errorMessage</div>
}

@if (isLoading)
{
    <p>Loading menu...</p>
}
else
{
    @if (!todayMenus.Any())
    {
        <div class="alert alert-info">No menu is available for today.</div>
    }
    else
    {
        <div class="row">
            @foreach (var menu in todayMenus)
            {
                bool isSoldOut = menu.Portions <= 0;

                <div class="col-md-4 mb-3">
                    <div class="card @(isSoldOut ? "bg-light text-muted border-secondary opacity-75" : "")">
                        <div class="card-body">
                            <h5 class="card-title">@menu.MealName</h5>
                            <p class="card-text"><strong>Price:</strong> @menu.Price Kč</p>
                            <p class="card-text"><strong>Available portions:</strong> @menu.Portions</p>

                            @if (isSoldOut)
                            {
                                <span class="badge bg-secondary">Sold out</span>
                            }
                            else
                            {
                                <button class="btn btn-primary" @onclick="() => CreateOrder(menu.Id)">
                                    Order
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <hr class="my-4" />

    <h3>All Active Orders</h3>

    @if (!studentOrders.Any())
    {
        <div class="alert alert-info">There are no orders yet.</div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Meal</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in studentOrders)
                {
                    <tr>
                        <td><strong>#@order.Id</strong></td>
                        <td>@order.MealName</td>
                        <td>@(order.Date.HasValue ? order.Date.Value.ToString("dd.MM.yyyy") : "")</td>
                        <td><span class="@GetStatusBadgeClass(order.Status)">@order.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private string? errorMessage;
    private bool isLoading = true;
    private List<MenuDto> todayMenus = new();
    private List<OrderDto> studentOrders = new();
    private DotNetObjectReference<ComponentBase>? objRef; // Opraven typ reference pro JS
    private string? anonymousUserId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // 1. Vyřešíme anonymní identitu
                anonymousUserId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "anon_user_id");
                if (string.IsNullOrEmpty(anonymousUserId))
                {
                    anonymousUserId = Guid.NewGuid().ToString();
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "anon_user_id", anonymousUserId);
                }

                // 2. Načteme data
                await LoadPageDataAsync();

                // 3. Spustíme SSE stream
                objRef = DotNetObjectReference.Create<ComponentBase>(this);
                var sseUrl = "http://web-api/api/orders/sse"; // Absolutní adresa pro jistotu
                await JSRuntime.InvokeVoidAsync("setupSse", sseUrl, objRef);
            }
            catch (Exception ex)
            {
                errorMessage = "JS Runtime error: " + ex.Message;
            }
            finally
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadPageDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            DateOnly today = DateOnly.FromDateTime(DateTime.Now.Date);

            var menus = await CanteenService.GetMenusAsync();
            var orders = await CanteenService.GetOrdersAsync();

            todayMenus = menus?.Where(menu => menu.Date == today).OrderBy(menu => menu.MealName).ToList() ?? new();
            studentOrders = orders?.OrderBy(order => order.Id).ToList() ?? new();
        }
        catch (Exception e)
        {
            errorMessage = "API Error: " + e.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CreateOrder(int menuId)
    {
        try
        {
            await CanteenService.CreateOrderAsync(menuId);
            await LoadPageDataAsync();
        }
        catch (Exception e)
        {
            errorMessage = "Could not create order: " + e.Message;
        }
    }

    // JS volá tuto metodu při změně přes SSE, aby se menu překreslilo
    [JSInvokable]
    public async Task RefreshDataAsync()
    {
        await LoadPageDataAsync();
    }

    private static string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Preparing" => "badge bg-warning text-dark",
            "Ready" => "badge bg-success",
            "Cancelled" => "badge bg-danger",
            "Finished" => "badge bg-secondary",
            _ => "badge bg-info text-dark"
        };
    }

    public void Dispose()
    {
        objRef?.Dispose();
        // Bezpečné ošetření JS volání při odchodu ze stránky
        _ = JSRuntime.InvokeVoidAsync("closeSse");
    }
}