@page "/kitchen/orders"
@using UTB.Minute.Contracts
@rendermode InteractiveServer
@inject CanteenService CanteenService
@using Microsoft.AspNetCore.Components.Authorization

<h3>Kitchen Orders</h3>
@* Authentication debug removed — production behavior only *@

<AuthorizeView Roles="canteen-admin">
    <Authorized>
        <p>Welcome back @context.User.Identity?.Name !</p>

        <form action="logout" method="post">
            <AntiforgeryToken />
            <button type="submit" class="nav-link btn btn-link">Logout</button>
        </form>

    </Authorized>
    <NotAuthorized>
        <p><a href="/login?returnUrl=/kitchen/orders">Log in</a> please.</p>
    </NotAuthorized>
</AuthorizeView>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (isLoading)
{
    <p>Loading orders...</p>
}
else if (!orders.Any())
{
    <div class="alert alert-info">
        There are no orders.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th style="width: 90px;">Order</th>
                <th>Meal</th>
                <th>Date</th>
                <th>Status</th>
                <th style="width: 300px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr class="@(order.Status == OrderStatus.Cancelled.ToString() ? "table-secondary text-muted" : "")">
                    <td>
                        <strong>#@order.Id</strong>
                    </td>
                    <td>@order.MealName</td>
                    <td>
                        @(order.Date.HasValue
                            ? order.Date.Value.ToString("dd.MM.yyyy")
                            : "")
                    </td>
                    <td>
                        <span class="@GetStatusBadgeClass(order.Status)">
                            @order.Status
                        </span>
                    </td>
                    <td>
                        <AuthorizeView Roles="canteen-admin">
                            <Authorized>
                                @if (order.Status == OrderStatus.Preparing.ToString())
                                {
                                    <button class="btn btn-success btn-sm me-2"
                                            disabled="@isSubmitting"
                                            @onclick="() => ChangeOrderStatus(order.Id, OrderStatus.Ready)">
                                        Ready
                                    </button>

                                    <button class="btn btn-danger btn-sm"
                                            disabled="@isSubmitting"
                                            @onclick="() => ChangeOrderStatus(order.Id, OrderStatus.Cancelled)">
                                        Cancel
                                    </button>
                                }
                                else if (order.Status == OrderStatus.Ready.ToString())
                                {
                                    <button class="btn btn-danger btn-sm me-2"
                                            disabled="@isSubmitting"
                                            @onclick="() => ChangeOrderStatus(order.Id, OrderStatus.Cancelled)">
                                        Cancel
                                    </button>

                                    <button class="btn btn-secondary btn-sm"
                                            disabled="@isSubmitting"
                                            @onclick="() => ChangeOrderStatus(order.Id, OrderStatus.Finished)">
                                        Finished
                                    </button>
                                }
                                else if (order.Status == OrderStatus.Cancelled.ToString())
                                {
                                    <span class="text-muted">Cancelled order cannot be changed</span>
                                }
                                else if (order.Status == OrderStatus.Finished.ToString())
                                {
                                    <span class="text-muted">Finished order cannot be changed</span>
                                }
                                else
                                {
                                    <span class="text-muted">No actions available</span>
                                }
                            </Authorized>
                            <NotAuthorized>
                                <!-- no action buttons for unauthorized users -->
                                <span class="text-muted">No actions available</span>
                            </NotAuthorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = true;
    private bool isSubmitting;

    private List<OrderDto> orders = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            successMessage = null;

            OrderDto[]? result = await CanteenService.GetOrdersAsync();

            orders = result?
                .OrderBy(order => order.Id)
                .ToList()
                ?? new List<OrderDto>();
        }
        catch (HttpRequestException e)
        {
            errorMessage = e.Message;
        }
        finally
        {
            isLoading = false;
        }
    }



    private async Task ChangeOrderStatus(int orderId, OrderStatus newStatus)
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            isSubmitting = true;

            var request = new OrderStatusRequestDto
            {
                Status = newStatus
            };

            await CanteenService.UpdateOrderStatusAsync(orderId, request);

            successMessage = $"Order #{orderId} status was changed.";
            await LoadOrdersAsync();
        }
        catch (HttpRequestException e)
        {
            errorMessage = e.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Preparing" => "badge bg-warning text-dark",
            "Ready" => "badge bg-success",
            "Cancelled" => "badge bg-danger",
            "Finished" => "badge bg-secondary",
            _ => "badge bg-info text-dark"
        };
    }
}