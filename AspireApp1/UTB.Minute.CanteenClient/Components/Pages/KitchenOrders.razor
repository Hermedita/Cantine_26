@page "/kitchen/orders"
@using UTB.Minute.Contracts
@using Microsoft.AspNetCore.Components.Authorization
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject CanteenService CanteenService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Kitchen Orders</PageTitle>

<h3>Kitchen Orders</h3>

@if (!isCookLoggedIn)
{
    <div class="card text-center my-5 p-5 shadow-sm">
        <div class="card-body">
            <h4 class="card-title mb-4">Sekce pro personál kuchyně</h4>
            <p class="card-text text-muted mb-4">Pro prohlížení a správu objednávek v reálném čase se prosím nejprve přihlaste svým kuchařským účtem.</p>
            <button class="btn btn-primary btn-lg px-5" @onclick="LoginCook">
                Přihlásit se do kuchyně
            </button>
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-warning">@errorMessage</div>
    }

    @if (isLoading)
    {
        <p>Loading orders...</p>
    }
    else if (!orders.Any())
    {
        <div class="alert alert-info">There are no orders.</div>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Meal</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in orders)
                {
                    <tr>
                        <td><strong>#@order.Id</strong></td>
                        <td>@order.MealName</td>
                        <td><span class="badge bg-info">@order.Status</span></td>
                        <td>
                            <button class="btn btn-success btn-sm" @onclick="() => ChangeOrderStatus(order.Id, OrderStatus.Ready)">Ready</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private bool isCookLoggedIn = false;
    private bool isLoading = true;
    private List<OrderDto> orders = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting;
    private bool isAuthorized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Zkontrolujeme stav
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true && user.IsInRole("canteen-admin"))
            {
                isCookLoggedIn = true;
                StateHasChanged();

                // Načteme objednávky (a případně nastartujeme SSE)
                await LoadOrdersAsync();
            }
            else
            {
                isCookLoggedIn = false;
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private void LoginCook()
    {
        // Vyvolá přihlášení a po něm kuchařku vrátí rovnou zpět sem
        NavigationManager.NavigateTo("/login?returnUrl=kitchen/orders", forceLoad: true);
    }

    private async Task LoadOrdersAsync()
    {
        try
        {
            isLoading = true;
            var result = await CanteenService.GetOrdersAsync();
            orders = result?.OrderBy(order => order.Id).ToList() ?? new List<OrderDto>();
        }
        catch (Exception e)
        {
            errorMessage = "Chyba při načítání objednávek: " + e.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ChangeOrderStatus(int orderId, OrderStatus status)
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            isSubmitting = true;
            var request = new OrderStatusRequestDto { Status = status };

            await CanteenService.UpdateOrderStatusAsync(orderId, request);

            successMessage = $"Order #{orderId} status was changed.";
            await LoadOrdersAsync();
        }
        catch (HttpRequestException e)
        {
            errorMessage = e.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}